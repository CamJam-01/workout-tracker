# Postgres connection string (Vercel Postgres/Neon, Supabase, or any Postgres host).
# Vercel's Postgres storage integration injects this automatically in production —
# only needed here for local development.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign login session cookies (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=3000
